--// АВТОМАТИЧЕСКИЙ МЯГКИЙ БАЙПАС (запускается сразу)
local function applyAutoBypass()
    -- 1) Скрываем наш GUI от простых сканеров PlayerGui
    pcall(function()
        local pg = LocalPlayer:WaitForChild("PlayerGui")
        local origGetDescendants = pg.GetDescendants
        pg.GetDescendants = function(self)
            local list = origGetDescendants(self)
            for i = #list, 1, -1 do
                if list[i] and list[i].Name == "NegorHub" then
                    table.remove(list, i)
                end
            end
            return list
        end
    end)

    -- 2) Спуфим WalkSpeed обратно к 16, если сервер проверяет через GetPropertyChangedSignal
    -- (это может помочь, если античит следит за свойствами)
    pcall(function()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hum = char:WaitForChild("Humanoid")
        -- не трогаем реальное значение, только "маскируем" при чтении извне
        local mt = getrawmetatable(game)
        if mt and mt.__index then
            setreadonly(mt, false)
            local oldIndex = mt.__index
            mt.__index = newcclosure(function(self, key)
                if self == hum and key == "WalkSpeed" then
                    return 16 -- возвращаем "нормальное" значение при проверке
                end
                return oldIndex(self, key)
            end)
            setreadonly(mt, true)
        end
    end)

    -- 3) Блокируем RemoteEvent, который может использоваться для репорта
    pcall(function()
        for _, obj in ipairs(game:GetDescendants()) do
            if obj:IsA("RemoteEvent") and (obj.Name:lower():find("report") or obj.Name:lower():find("kick") or obj.Name:lower():find("detect")) then
                obj.OnClientEvent:Connect(function() end)
            end
        end
    end)

    print("[Negor Hub] Soft bypass applied")
end

applyAutoBypass()

--// Anti Bat
local AntiBatEnabled = false
local CurrentKeybind = Enum.KeyCode.N
local WaitingForKeybind = false
local Locked = false
local AntiBatConn = nil

local function startAntiBat()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    if AntiBatConn then AntiBatConn:Disconnect() end
    AntiBatConn = RunService.Heartbeat:Connect(function()
        if not root or not root.Parent then return end
        local origXZ = Vector3.new(root.Velocity.X, 0, root.Velocity.Z)
        -- Импульс уменьшен, чтобы меньше триггерить проверки скорости
        root.Velocity = Vector3.new(450, root.Velocity.Y, 450)
        RunService.RenderStepped:Wait()
        root.Velocity = Vector3.new(origXZ.X, root.Velocity.Y, origXZ.Z)
    end)
end

local function stopAntiBat()
    if AntiBatConn then
        AntiBatConn:Disconnect()
        AntiBatConn = nil
    end
end

