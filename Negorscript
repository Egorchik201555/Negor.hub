local function setToggle(enabled)
    local onPos = UDim2.new(1, -17, 0.5, -7)
    local offPos = UDim2.new(0, 3, 0.5, -7)
    TweenService:Create(ToggleKnob, TweenInfo.new(0.18, Enum.EasingStyle.Back), {
        Position = enabled and onPos or offPos,
        BackgroundColor3 = enabled and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(230, 240, 255),
    }):Play()
    TweenService:Create(ToggleBg, TweenInfo.new(0.18), {
        BackgroundColor3 = enabled and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(40, 60, 100),
    }):Play()
end

local function toggleAntiBat()
    AntiBatEnabled = not AntiBatEnabled
    if AntiBatEnabled then
        startAntiBat()
        CardStatus.Text = "ON"
        CardStatus.TextColor3 = Color3.fromRGB(0, 220, 255)
    else
        stopAntiBat()
        CardStatus.Text = "OFF"
        CardStatus.TextColor3 = Color3.fromRGB(150, 180, 220)
    end
    setToggle(AntiBatEnabled)
end

ToggleClick.MouseButton1Click:Connect(toggleAntiBat)

KBButton.MouseButton1Click:Connect(function()
    if WaitingForKeybind then return end
    WaitingForKeybind = true
    KBButton.Text = "..."
    KBButton.TextColor3 = Color3.fromRGB(255, 210, 110)
end)

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if WaitingForKeybind then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            CurrentKeybind = input.KeyCode
            WaitingForKeybind = false
            KBButton.Text = CurrentKeybind.Name
            KBButton.TextColor3 = Color3.fromRGB(230, 240, 255)
        end
        return
    end
    if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == CurrentKeybind then
        toggleAntiBat()
    end
end)

LockBtn.MouseButton1Click:Connect(function()
    Locked = not Locked
    LockBtn.Text = Locked and "🔒" or "🔓"
end)

local dragging, dragStart, startPos
Header.InputBegan:Connect(function(input)
    if Locked then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and not Locked and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

